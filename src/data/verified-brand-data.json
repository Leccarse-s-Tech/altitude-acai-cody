  "bowlAnatomy": {
    "heading": "What's in an Açaí Bowl?",
    "siteHeading": "What's in an Acai Bowl???",
    "copy": "An Açaí Bowl is your ultimate build-your-own adventure in a bowl—starting with our delicious, nutrient-rich superfood base: smooth, refreshing açaí sorbet. From there, it's all about YOU. Layer in your choice of CRUNCH, your favorite fruits, mouthwatering toppings, and a drizzle of sauce to finish it off. Every bowl is a perfect mix of flavor, texture, and feel-good energy—fresh, fun, and made exactly how you like it.",
    "layersBottomToTop": [
      {
        "order": 1,
        "id": "acai-sorbet",
        "name": "ACAI SORBET",
        "displayName": "Açaí Sorbet",
        "role": "Base",
        "description": "Smooth, refreshing nutrient-rich superfood açaí sorbet base"
      },
      {
        "order": 2,
        "id": "crunch",
        "name": "CRUNCH",
        "displayName": "Crunch",
        "role": "Granola Layer",
        "description": "Granola base included in every bowl"
      },
      {
        "order": 3,
        "id": "favorite-fruit",
        "name": "FAVORITE FRUIT",
        "displayName": "Favorite Fruit",
        "role": "Fresh Fruit Layer",
        "description": "Choice of up to 3 fresh fruits"
      },
      {
        "order": 4,
        "id": "topping",
        "name": "TOPPING",
        "displayName": "Topping",
        "role": "Toppings Layer",
        "description": "Choice of up to 2 seeds, nuts, shavings, or dry toppings"
      },
      {
        "order": 5,
        "id": "sauce",
        "name": "SAUCE",
        "displayName": "Sauce",
        "role": "Finish Layer",
        "description": "Drizzle of 1 sauce or nut butter to finish"
      }
    ]
  },
